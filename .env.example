# 服务监听端口。docker-compose.yml 默认把宿主机 8788 映射到容器 8788。
PORT=8788

# 对外访问路径。反代到 https://你的域名/choujiang/ 时保持 /choujiang。
PUBLIC_BASE_PATH=/choujiang

# Sub2API 地址。
# 如果 choujiang 和 Sub2API 在同一个 Docker Compose 网络，可用 http://sub2api:3000。
# 如果 choujiang 在 Docker，Sub2API/Caddy/Nginx 在宿主机，可用 http://host.docker.internal:18080。
SUB2API_BASE_URL=http://host.docker.internal:18080
SUB2API_AUTH_ME_PATH=/api/v1/auth/me

# Sub2API 管理员 API Key。只保存在服务端，不会暴露给浏览器。
SUB2API_ADMIN_API_KEY=change-this-admin-api-key
SUB2API_ADMIN_AUTH_HEADER=x-api-key
SUB2API_ADMIN_AUTH_VALUE=

# Sub2API 余额增加接口。大多数情况保持默认即可。
SUB2API_BALANCE_PATH_TEMPLATE=/api/v1/admin/users/{id}/balance
SUB2API_BALANCE_OPERATION=add
SUB2API_BALANCE_AMOUNT_FIELD=balance

# 可选：抽奖前要求用户当天消费达到指定金额。
# LOTTERY_REQUIRE_DAILY_SPEND 和 LOTTERY_REQUIRED_DAILY_SPEND 是首次启动时的默认值，之后可在管理后台调整。
# 消费查询接口、鉴权和金额字段仍需通过环境变量配置。
# 支持占位符：{id}/{userId}/{user_id}/{date}/{start}/{end}/{start_iso}/{end_iso}/{start_ts}/{end_ts}/{start_ms}/{end_ms}
LOTTERY_REQUIRE_DAILY_SPEND=true
LOTTERY_REQUIRED_DAILY_SPEND=10
SUB2API_DAILY_SPEND_AUTH_HEADER=Authorization
SUB2API_DAILY_SPEND_AUTH_VALUE=Bearer your-admin-token
SUB2API_DAILY_SPEND_METHOD=POST
# 示例：Sub2API 管理端用量统计接口。
SUB2API_DAILY_SPEND_PATH_TEMPLATE=/api/v1/admin/dashboard/users-usage
SUB2API_DAILY_SPEND_BODY_TEMPLATE={"user_ids":[{id}]}
SUB2API_DAILY_SPEND_AMOUNT_FIELD=data.stats.{id}.today_actual_cost

# 抽奖基础配置。
LOTTERY_UNIT=USD
LOTTERY_TIMEZONE=Asia/Shanghai
LOTTERY_ADMIN_PASSWORD=change-this-password
LOTTERY_DB_FILE=./data/lottery.db
LOTTERY_NOTE_PREFIX=Lucky wheel draw
# 是否在用户页公示每个奖项的中奖概率。默认关闭。
LOTTERY_SHOW_PROBABILITY=false

# 首次启动时写入 SQLite 的奖品池；之后推荐在管理后台修改。
# 格式：金额:权重:名称（用英文逗号分隔多个奖项），概率 = 权重 / 权重总和。
# 默认：0.1 x28%、0.2 x22%、0.3 x16%、0.5 x12%、0.8 x9%、1 x7%、1.5 x4%、2 x2%。
# LOTTERY_PRIZES=0.1:280:小确幸,0.2:220:小惊喜,0.3:160:好运到,0.5:120:幸运星,0.8:90:小锦鲤,1:70:欧气满满,1.5:40:超级幸运,2:20:锦鲤附体

# 当用户页与 Sub2API 同源时，尝试读取登录 token 的 localStorage key 列表。
# 正常情况下无需修改；如果你的 Sub2API 前端 token key 不同，再追加到这里。
PUBLIC_TOKEN_STORAGE_KEYS=token,access_token,auth_token,sub2api_token,auth-storage,user,sub2api-auth
